# Public API URL used by the built Astro frontend.
PUBLIC_REVIEW_API_URL=https://landing.pabloaf.com

# Docker listener. Keep 127.0.0.1 if cloudflared runs on the host.
# Use the server's DMZ IP (for example 10.10.30.10) if cloudflared runs in Docker.
REVIEW_API_BIND_IP=127.0.0.1
REVIEW_API_PORT=9000

# Deployment webhook and static site origin.
# Use 10.10.30.10 when cloudflared runs in Docker on the publicservices VM.
DEPLOY_WEBHOOK_BIND_IP=127.0.0.1
DEPLOY_WEBHOOK_PORT=9001
SITE_BIND_IP=10.10.30.10
SITE_PORT=8081
DEPLOY_BRANCH=master
GITHUB_WEBHOOK_SECRET=replace_with_the_same_secret_configured_in_github

# Review API
PORT=3000
TRUST_PROXY=1
REVIEW_TIMEZONE=Europe/Madrid
CORS_ALLOWED_ORIGINS=https://pabloaf.com,https://www.pabloaf.com,http://localhost:4321
MAX_IMAGE_BYTES=5242880
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=10

# GitHub fine-grained PAT or GitHub App token.
# Required permissions on Pablo-ArgF/Portfolio:
#   Contents: Read and write
#   Pull requests: Read and write
GITHUB_TOKEN=replace_with_a_github_token
GITHUB_REPOSITORY=Pablo-ArgF/Portfolio
GITHUB_BASE_BRANCH=master
